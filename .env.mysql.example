# Copy to .env.mysql and set two independent passwords before starting.
# docker compose --env-file .env.mysql up -d --wait
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=
DB_USERNAME=formaspace_app
DB_PASSWORD=
DB_URL='jdbc:mysql://127.0.0.1:3307/formaspace?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&preserveInstants=true&characterEncoding=UTF-8'
