# Spring Boot does not auto-load this file. Export these variables or configure the IDE.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:mysql://localhost:3306/formaspace?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&preserveInstants=true&characterEncoding=UTF-8
DB_USERNAME=formaspace_app
DB_PASSWORD=
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional this iteration; no email is sent. STARTTLS/587 and SSL/465 are mutually exclusive.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
# For future email feature: Base64 encoding of at least 32 random bytes. No demo key.
AUTH_CODE_HMAC_KEY=
