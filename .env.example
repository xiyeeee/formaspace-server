# Spring Boot does NOT auto-load .env. Inject through the shell/IDE/deployment secrets.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:mysql://localhost:3306/formaspace?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&preserveInstants=true&characterEncoding=UTF-8
DB_USERNAME=formaspace_app
DB_PASSWORD=
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
# local allows localhost/127.0.0.1 on any port; set exact origins for prod.
CORS_ALLOWED_ORIGINS=
# Both keys are required, independent Base64 random values, decoded length >= 32 bytes.
JWT_SECRET=
AUTH_CODE_HMAC_KEY=
JWT_ISSUER=formaspace-server
JWT_AUDIENCE=formaspace-web
JWT_ACCESS_TOKEN_TTL=2h
JWT_CLOCK_SKEW=30s
# Disabled by default: endpoint returns 503 MAIL_UNAVAILABLE, never a pretend send.
EMAIL_CODE_ENABLED=false
EMAIL_CODE_TTL=5m
EMAIL_CODE_COOLDOWN=60s
EMAIL_CODE_MAX_FAILURES=5
EMAIL_CODE_EMAIL_HOURLY=5
EMAIL_CODE_IP_HOURLY=20
AUTH_LOGIN_WINDOW=15m
AUTH_LOGIN_ACCOUNT_FAILURES=10
AUTH_LOGIN_IP_FAILURES=50
AUTH_REGISTER_WINDOW=15m
AUTH_REGISTER_EMAIL_ATTEMPTS=10
AUTH_REGISTER_IP_ATTEMPTS=30
# Configure before enabling mail. STARTTLS/587 or SSL/465, never both.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false

# Source files and user-managed model copies; use a real directory outside the repository.
# Empty FILE_STORAGE_ROOT means leave it unset and use the application default: ~/.formaspace/storage.
# FILE_STORAGE_ROOT=/absolute/path/outside/repository/formaspace-storage
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PIXELS=16000000
MODEL_MAX_BYTES=104857600
INFERENCE_MODE=DISABLED
GENERATION_MAX_ACTIVE_PER_USER=1
# MOCK requires local/dev/test and is rejected in prod. Parameters never alter the demo model.
MOCK_CONCURRENCY=1
MOCK_STAGE_DELAY=2s
MOCK_POLL_DELAY_MS=1000
# Optional, self-contained local GLB owned/provided by you. No fallback model is downloaded.
MOCK_DEMO_GLB=

# Real local Gradio integration (verified protocol: Gradio 6.32.0). Keep INFERENCE_MODE=DISABLED above until enabling.
# INFERENCE_MODE=HUNYUAN_LOCAL
HUNYUAN_BASE_URL=http://127.0.0.1:7860
HUNYUAN_API_NAME=shape_generation
HUNYUAN_CONNECT_TIMEOUT=5s
HUNYUAN_READ_TIMEOUT=60s
HUNYUAN_TASK_TIMEOUT=30m
HUNYUAN_RETRY_INTERVAL=5s
HUNYUAN_MAXIMUM_RETRIES=3
HUNYUAN_MODEL_ID=tencent/Hunyuan3D-2mini
HUNYUAN_SUBFOLDER=hunyuan3d-dit-v2-mini
HUNYUAN_PROFILE_ID=hunyuan-mini-mps-adjustable-v2
# Independent STANDARD candidate; no MPS quality/performance validation claim.
HUNYUAN_INFERENCE_STEPS=30
HUNYUAN_GUIDANCE_SCALE=5
HUNYUAN_OCTREE_RESOLUTION=256
HUNYUAN_NUM_CHUNKS=1000
# Optional model-service/reverse-proxy credential, never the end user's application JWT.
HUNYUAN_AUTHORIZATION=

# Adjustable local Gradio parameter limits. These are not a performance guarantee.
HUNYUAN_MINIMUM_STEPS=1
HUNYUAN_MAXIMUM_STEPS=100
HUNYUAN_MINIMUM_GUIDANCE=0
HUNYUAN_MAXIMUM_GUIDANCE=10
HUNYUAN_MINIMUM_OCTREE_RESOLUTION=16
HUNYUAN_MAXIMUM_OCTREE_RESOLUTION=512
HUNYUAN_MAXIMUM_VOXEL_STEPS=13421772800

# New persistent HTTP/WebSocket API; separate from HUNYUAN_LOCAL / Gradio.
# INFERENCE_MODE=PYTHON_REALTIME
INFERENCE_API_BASE_URL=http://127.0.0.1:8001
# Optional; unset derives ws/wss from the HTTP base URL.
# INFERENCE_WS_BASE_URL=ws://127.0.0.1:8001
INFERENCE_API_TOKEN=
INFERENCE_CONNECT_TIMEOUT=5s
INFERENCE_SUBMIT_TIMEOUT=20s
INFERENCE_SNAPSHOT_TIMEOUT=5s
INFERENCE_DOWNLOAD_TIMEOUT=2m
INFERENCE_TASK_DEADLINE=30m
INFERENCE_RECONNECT_INITIAL_DELAY=2s
INFERENCE_RECONNECT_MAX_DELAY=30s
INFERENCE_RECONCILIATION_INTERVAL=10s
INFERENCE_MAXIMUM_CONNECTIONS=1
INFERENCE_MAXIMUM_MESSAGE_BYTES=2097152
INFERENCE_MAXIMUM_DOWNLOAD_BYTES=104857600
INFERENCE_MAXIMUM_SUBMISSION_ATTEMPTS=4
REALTIME_STEPS=30
REALTIME_GUIDANCE_SCALE=5
REALTIME_FINAL_RESOLUTION=256
REALTIME_NUM_CHUNKS=4000
REALTIME_PREVIEW_ENABLED=true
# 新任务默认三阶段；设为 6 启用保留的六阶段计划，重启 Java 生效
REALTIME_PREVIEW_STAGE_COUNT=3
REALTIME_PREVIEW_STEP=24
REALTIME_PREVIEW_RESOLUTION=128
REALTIME_POINT_COUNT=5000
