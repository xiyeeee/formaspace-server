# Spring Boot does NOT auto-load .env. Inject through the shell/IDE/deployment secrets.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:mysql://localhost:3306/formaspace?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&preserveInstants=true&characterEncoding=UTF-8
DB_USERNAME=formaspace_app
DB_PASSWORD=
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Both keys are required, independent Base64 random values, decoded length >= 32 bytes.
JWT_SECRET=
AUTH_CODE_HMAC_KEY=
JWT_ISSUER=formaspace-server
JWT_AUDIENCE=formaspace-web
JWT_ACCESS_TOKEN_TTL=2h
JWT_CLOCK_SKEW=30s
# Disabled by default: endpoint returns 503 MAIL_UNAVAILABLE, never a pretend send.
EMAIL_CODE_ENABLED=false
EMAIL_CODE_TTL=5m
EMAIL_CODE_COOLDOWN=60s
EMAIL_CODE_MAX_FAILURES=5
EMAIL_CODE_EMAIL_HOURLY=5
EMAIL_CODE_IP_HOURLY=20
AUTH_LOGIN_WINDOW=15m
AUTH_LOGIN_ACCOUNT_FAILURES=10
AUTH_LOGIN_IP_FAILURES=50
AUTH_REGISTER_WINDOW=15m
AUTH_REGISTER_EMAIL_ATTEMPTS=10
AUTH_REGISTER_IP_ATTEMPTS=30
# Configure before enabling mail. STARTTLS/587 or SSL/465, never both.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false

# Source files and user-managed model copies; use a real directory outside the repository.
# Empty FILE_STORAGE_ROOT means leave it unset and use the application default: ~/.formaspace/storage.
# FILE_STORAGE_ROOT=/absolute/path/outside/repository/formaspace-storage
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PIXELS=16000000
MODEL_MAX_BYTES=104857600
INFERENCE_MODE=DISABLED
GENERATION_MAX_ACTIVE_PER_USER=1
# MOCK requires local/dev/test and is rejected in prod. Parameters never alter the demo model.
MOCK_CONCURRENCY=1
MOCK_STAGE_DELAY=2s
MOCK_POLL_DELAY_MS=1000
# Optional, self-contained local GLB owned/provided by you. No fallback model is downloaded.
MOCK_DEMO_GLB=
